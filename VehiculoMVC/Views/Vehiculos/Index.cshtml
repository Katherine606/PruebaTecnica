@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@model IEnumerable<VehiculoMVC.Models.ViewModels.VehiculoViewModel>

@{
    ViewData["Title"] = "Gestión de Flota";
    var rolActual = HttpContextAccessor.HttpContext?.Session.GetString("Rol");
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold text-dark mb-1">Flota de Vehículos</h4>
            <p class="text-secondary small mb-0">Control y administración general del inventario</p>
        </div>
        @if (rolActual == "Admin")
        {
            <a asp-controller="Vehiculos" asp-action="Crear" class="btn btn-dark btn-sm px-3 py-2 rounded-2">
                <i class="bi bi-plus-lg me-1"></i> Nuevo Vehículo
            </a>
        }
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-5 border rounded-3 bg-light">
            <i class="bi bi-car-front text-secondary fs-1 mb-2 d-block"></i>
            <p class="text-secondary small mb-0">No hay vehículos registrados actualmente.</p>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="bg-light text-secondary small text-uppercase">
                        <tr>
                            <th class="py-3 ps-4">Placa</th>
                            <th class="py-3">Vehículo</th>
                            <th class="py-3">Año</th>
                            <th class="py-3">Precio / Día</th>
                            <th class="py-3">Kilometraje</th>
                            <th class="py-3">Categoría</th>
                            <th class="py-3">Estado</th>
                            @if (rolActual == "Admin")
                            {
                                <th class="py-3 text-end pe-4">Acciones</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="fw-semibold font-monospace text-dark">@item.Placa</span>
                                </td>
                                <td>
                                    <span class="fw-semibold text-dark d-block">@item.Marca</span>
                                    <span class="text-secondary small">@item.Modelo</span>
                                </td>
                                <td><span class="text-secondary">@item.AnioFabricacion</span></td>
                                <td class="fw-semibold text-dark">$@item.PrecioAlquilerPorDia.ToString("N2")</td>
                                <td><span class="text-secondary">@item.Kilometraje.ToString("N0") km</span></td>
                                <td>
                                    <span class="badge bg-light text-secondary">@item.Categoria</span>
                                </td>
                                <td>
                                    @{
                                        var badgeClass = item.Estado switch
                                        {
                                            "Disponible" => "bg-success-subtle text-success",
                                            "Alquilado" => "bg-warning-subtle text-warning-emphasis",
                                            "En Mantenimiento" => "bg-danger-subtle text-danger",
                                            _ => "bg-secondary-subtle text-secondary"
                                        };
                                    }
                                    <span class="badge @badgeClass fw-normal px-2 py-1">@item.Estado</span>
                                </td>
                                @if (rolActual == "Admin")
                                {
                                    <td class="text-end pe-4">
                                        <div class="d-inline-flex gap-1">
                                            <a asp-controller="Vehiculos" asp-action="Edit" asp-route-id="@item.Placa" class="btn btn-light btn-sm text-secondary" title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <button type="button" class="btn btn-light btn-sm text-danger" title="Eliminar" onclick="confirmarEliminar('@item.Placa')">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>


<div class="modal fade" id="modalEliminar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow">
            <div class="modal-body text-center p-4">
                <i class="bi bi-exclamation-circle text-danger fs-1 mb-2 d-block"></i>
                <h6 class="fw-bold mb-1">¿Eliminar vehículo?</h6>
                <p class="text-secondary small mb-3">Se borrará la placa <strong id="placaEliminar"></strong> de la base de datos.</p>
                <form id="formEliminar" method="post" asp-controller="Vehiculos" asp-action="Eliminar">
                    <input type="hidden" name="placa" id="inputPlacaEliminar" />
                    <div class="d-flex gap-2 justify-content-center">
                        <button type="button" class="btn btn-light btn-sm px-3" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-danger btn-sm px-3">Sí, eliminar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <script>
        function confirmarEliminar(placa) {
            document.getElementById('placaEliminar').innerText = placa;
            document.getElementById('inputPlacaEliminar').value = placa;
            var modal = new bootstrap.Modal(document.getElementById('modalEliminar'));
            modal.show();
        }
    </script>
}