@model VehiculoMVC.Models.ViewModels.VehiculoCrearVM

<div class="row mt-4">
    <div class="col-sm-6 offset-sm-3">
        <h2>Nuevo Vehículo</h2>

        <form asp-controller="Vehiculos" asp-action="Nuevo" method="post">
            <div class="mb-3">
                <label asp-for="Placa" class="form-label">Placa</label>
                <input type="text" class="form-control" asp-for="Placa" placeholder="Ej. ABC-1234">
                <span asp-validation-for="Placa" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Marca" class="form-label">Marca</label>
                <input type="text" class="form-control" asp-for="Marca" placeholder="Ej. Toyota">
                <span asp-validation-for="Marca" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Modelo" class="form-label">Modelo</label>
                <input type="text" class="form-control" asp-for="Modelo" placeholder="Ej. Corolla">
                <span asp-validation-for="Modelo" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="AnioFabricacion" class="form-label">Año de Fabricación</label>
                <input type="number" class="form-control" asp-for="AnioFabricacion" min="1900" max="2100">
                <span asp-validation-for="AnioFabricacion" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PrecioAlquilerPorDia" class="form-label">Precio Alquiler por Día ($)</label>
                <input type="number" step="0.01" class="form-control" asp-for="PrecioAlquilerPorDia">
                <span asp-validation-for="PrecioAlquilerPorDia" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Kilometraje" class="form-label">Kilometraje</label>
                <input type="number" class="form-control" asp-for="Kilometraje" min="0">
                <span asp-validation-for="Kilometraje" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Categoria" class="form-label">Categoría</label>
                <select class="form-select" asp-for="Categoria">
                    <option value="" disabled selected>-- Seleccione una categoría --</option>
                    <option value="Sedán">Sedán</option>
                    <option value="SUV">SUV</option>
                    <option value="Camioneta">Camioneta</option>
                    <option value="Lujo">Lujo</option>
                </select>
                <span asp-validation-for="Categoria" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Estado" class="form-label">Estado Operativo</label>
                <select class="form-select" asp-for="Estado">
                    <option value="Disponible">Disponible</option>
                    <option value="Alquilado">Alquilado</option>
                    <option value="En Mantenimiento">En Mantenimiento</option>
                </select>
                <span asp-validation-for="Estado" class="text-danger"></span>
            </div>

            @if (ViewBag.message != null)
            {
                <div class="alert alert-danger" role="alert">
                    @ViewBag.message
                </div>
            }

            <div class="d-grid gap-2 d-md-block">
                <button class="btn btn-primary" type="submit">Crear</button>
                <a asp-controller="Gestion" asp-action="Index" class="btn btn-warning">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}