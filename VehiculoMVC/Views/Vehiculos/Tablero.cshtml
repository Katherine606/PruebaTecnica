@model VehiculoMVC.Models.ViewModels.TableroViewModel

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold text-dark mb-1">Tablero y Reportes de Flota</h4>
    
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3 py-2 rounded-2">
            <i class="bi bi-arrow-left me-1"></i> Volver a la Flota
        </a>
    </div>


    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white">
                <span class="text-secondary small text-uppercase fw-semibold">Total de Vehículos</span>
                <h3 class="fw-bold text-dark mb-0 mt-1">@(Model?.TotalVehiculos ?? 0)</h3>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white">
                <span class="text-secondary small text-uppercase fw-semibold">Valor Proyectado Diario</span>
                <h3 class="fw-bold text-success mb-0 mt-1">$@(Model?.ValorMonetarioTotalProyectadoDiario.ToString("N2") ?? "0.00")</h3>
            </div>
        </div>
    </div>

    
    <h5 class="fw-bold text-dark mb-3">Desglose por Categoría</h5>
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden mb-4">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="bg-light text-secondary small text-uppercase">
                    <tr>
                        <th class="py-3 ps-4">Categoría</th>
                        <th class="py-3">Total</th>
                        <th class="py-3">Promedio Km</th>
                        <th class="py-3">Costo Promedio</th>
                        <th class="py-3">Proyección Diaria</th>
                        <th class="py-3 pe-4">Recargo Seguro Lujo (12%)</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model?.DesglosePorCategoria != null && Model.DesglosePorCategoria.Any())
                    {
                        foreach (var cat in Model.DesglosePorCategoria)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="badge bg-light text-secondary">@cat.Categoria</span>
                                </td>
                                <td><span class="fw-semibold text-dark">@cat.TotalVehiculos</span></td>
                                <td><span class="text-secondary">@Math.Round(cat.PromedioKilometraje, 0).ToString("N0") km</span></td>
                                <td><span class="text-secondary">$@Math.Round(cat.CostoPromedioAlquiler, 2).ToString("N2")</span></td>
                                <td class="fw-semibold text-dark">$@cat.ValorTotalProyectadoDiario.ToString("N2")</td>
                                <td class="pe-4 text-secondary">$@cat.TotalRecargosSeguroLujo.ToString("N2")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-secondary">No hay datos de categorías disponibles.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <h5 class="fw-bold text-dark mb-3">Vehículos que Requieren Atención Inmediata</h5>
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="bg-light text-secondary small text-uppercase">
                    <tr>
                        <th class="py-3 ps-4">Placa</th>
                        <th class="py-3">Marca</th>
                        <th class="py-3">Kilometraje</th>
                        <th class="py-3">Clasificación</th>
                        <th class="py-3 pe-4">Estado Operativo</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model?.VehiculosRequierenAtencion != null && Model.VehiculosRequierenAtencion.Any())
                    {
                        foreach (var v in Model.VehiculosRequierenAtencion)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="fw-semibold font-monospace text-dark">@v.Placa</span>
                                </td>
                                <td><span class="fw-semibold text-dark">@v.Marca</span></td>
                                <td><span class="text-secondary">@v.Kilometraje.ToString("N0") km</span></td>
                                <td>
                                    <span class="badge bg-warning-subtle text-warning-emphasis fw-normal px-2 py-1">@v.ClasificacionKilometraje</span>
                                </td>
                                <td class="pe-4">
                                    <span class="badge bg-danger-subtle text-danger fw-normal px-2 py-1">@v.Estado</span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-secondary">Ningún vehículo requiere atención en este momento.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
}