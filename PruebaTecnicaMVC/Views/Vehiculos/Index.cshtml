@model IEnumerable<PruebaTecnicaMVC.Models.VehiculoViewModel>

<div class="container mt-4">
    <h2>Gestión de Flota</h2>
    <p>
        <a asp-action="Crear" class="btn btn-primary btn-sm">Nuevo Vehículo</a>
        <a asp-action="Tablero" class="btn btn-secondary btn-sm">Ver Tablero / Reportes</a>
    </p>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-warning" role="alert">
            No hay vehículos registrados o no se pudieron cargar desde la API.
        </div>
    }
    else
    {
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>Placa</th>
                    <th>Marca</th>
                    <th>Modelo</th>
                    <th>Año</th>
                    <th>Precio/Día</th>
                    <th>Km</th>
                    <th>Categoría</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Placa</td>
                        <td>@item.Marca</td>
                        <td>@item.Modelo</td>
                        <td>@item.AnioFabricacion</td>
                        <td>$@item.PrecioAlquilerPorDia</td>
                        <td>@item.Kilometraje</td>
                        <td>@item.Categoria</td>
                        <td>@item.Estado</td>
                        <td>
                            <a asp-action="Eliminar" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>